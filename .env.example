QDRANT_PORT=6333

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# NATS JetStream
NATS_URL=nats://localhost:4222

# LLM Providers (Required for Sprint 1 Evals)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
