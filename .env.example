# Server Config
PORT=8080
ENV=development

# Database Config
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aipods_user
POSTGRES_PASSWORD=aipods_password
POSTGRES_DB=aipods_db

# Qdrant Vector DB
